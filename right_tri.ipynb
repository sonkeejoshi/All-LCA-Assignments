   "source": [
    "b = float(input(\"Whats the base?\")) \n",
    "ht = float(input(\"Whats the height?\")) \n",
    "hp = float(input(\"Whats the hypotenuse?\")) \n",
    "def is_right_tri():\n",
    " if (hp**2 == b**2 + ht**2):\n",
    "    print(\"Triangle is right angled.\")\n",
    " else:\n",
    "    print(\"Triangle is not right angled.\")\n",
    "\n",
    "is_right_tri()"
   ]
